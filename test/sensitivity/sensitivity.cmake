set(ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/../..")
set(DATASET "${DATASET}" CACHE STRING "Dataset namespace")
set(CMR "${ROOT_DIR}/data/${DATASET}/KCOR_CMR.xlsx")
set(OUT_DIR "${CMAKE_CURRENT_LIST_DIR}/out")
set(OUT_XLSX "${OUT_DIR}/KCOR_SA.xlsx")

set(SA_SLOPE_START "53,53,1" CACHE STRING "SA_SLOPE_START")
set(SA_SLOPE_LENGTH "21,61,10" CACHE STRING "SA_SLOPE_LENGTH")
set(SA_YOB "0" CACHE STRING "SA_YOB")
set(SA_COHORTS "2021_24" CACHE STRING "SA_COHORTS")
set(SA_DOSE_PAIRS "1,0\;2,0" CACHE STRING "SA_DOSE_PAIRS")
set(SA_ANCHOR_WEEKS "4" CACHE STRING "SA_ANCHOR_WEEKS")
set(SA_MA_TOTAL_LENGTH "8" CACHE STRING "SA_MA_TOTAL_LENGTH")
set(SA_CENTERED "1" CACHE STRING "SA_CENTERED")
set(SA_SLOPE_WINDOW_SIZE "2" CACHE STRING "SA_SLOPE_WINDOW_SIZE")
set(SA_FINAL_KCOR_MIN "0,1,1" CACHE STRING "SA_FINAL_KCOR_MIN")
set(SA_FINAL_KCOR_DATE "4/1/24" CACHE STRING "SA_FINAL_KCOR_DATE")

add_custom_command(
  OUTPUT ${OUT_XLSX}
  COMMAND ${CMAKE_COMMAND} -E make_directory ${OUT_DIR}
  COMMAND ${CMAKE_COMMAND} -E env
    SENSITIVITY_ANALYSIS=1
    SA_SLOPE_START=${SA_SLOPE_START}
    SA_SLOPE_LENGTH=${SA_SLOPE_LENGTH}
    SA_YOB=${SA_YOB}
    SA_COHORTS=${SA_COHORTS}
    SA_DOSE_PAIRS=${SA_DOSE_PAIRS}
    SA_ANCHOR_WEEKS=${SA_ANCHOR_WEEKS}
    SA_MA_TOTAL_LENGTH=${SA_MA_TOTAL_LENGTH}
    SA_CENTERED=${SA_CENTERED}
    SA_SLOPE_WINDOW_SIZE=${SA_SLOPE_WINDOW_SIZE}
    SA_FINAL_KCOR_MIN=${SA_FINAL_KCOR_MIN}
    SA_FINAL_KCOR_DATE=${SA_FINAL_KCOR_DATE}
    ${Python3_EXECUTABLE} ${ROOT_DIR}/code/KCOR.py ${CMR} ${OUT_XLSX} "Sensitivity Analysis" KCOR_summary_SA.log
  DEPENDS ${ROOT_DIR}/code/KCOR.py ${CMR}
  COMMENT "Running sensitivity analysis"
)

add_custom_target(test_sensitivity DEPENDS ${OUT_XLSX})

add_custom_target(test_sensitivity_clean
  COMMAND ${CMAKE_COMMAND} -E rm -f ${OUT_XLSX} ${OUT_DIR}/KCOR_summary_SA.log ${OUT_DIR}/KCOR_summary.xlsx
)
