+def _finite_hazard_ratio(numerator, denominator):
+    """Nonnegative finite ratio; no arbitrary near-zero floor.
+
+    A genuine zero numerator is valid. A positive numerator that overflows
+    or underflows to zero is numerically unavailable, not clipped.
+    """
+    num,den=np.broadcast_arrays(np.asarray(numerator,float),np.asarray(denominator,float))
+    valid=np.isfinite(num)&np.isfinite(den)&(num>=0)&(den>0)
+    with np.errstate(divide="ignore",over="ignore",under="ignore",invalid="ignore"):
+        ratio=np.divide(num,den,out=np.full(num.shape,np.nan),where=valid)
+    ratio=np.where(np.isfinite(ratio)&((ratio>0)|(num==0)),ratio,np.nan)
+    return float(ratio) if ratio.ndim==0 else ratio
+
