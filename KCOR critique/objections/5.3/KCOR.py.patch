+def _set_kcor_reference(merged):
+    """Keep the two estimands separate, using the actual configured week."""
+    num = merged["CH_num"].to_numpy(float)
+    den = merged["CH_den"].to_numpy(float)
+    raw = np.divide(num, den, out=np.full(len(merged), np.nan),
+                    where=np.isfinite(num) & np.isfinite(den) & (den > EPS))
+    ref = np.flatnonzero((merged["t_num"].to_numpy() == KCOR_NORMALIZATION_WEEKS_EFFECTIVE)
+                         & (merged["t_den"].to_numpy() == KCOR_NORMALIZATION_WEEKS_EFFECTIVE))
+    idx = int(ref[0]) if len(ref) == 1 else None
+    ratio = raw[idx] if idx is not None else np.nan
+    valid = bool(np.isfinite(ratio) and ratio > EPS)
+    merged["K_raw"] = raw
+    merged["KCOR_unanchored"] = raw
+    merged["KCOR_anchored"] = raw / ratio if valid else np.nan
+    merged["KCOR"] = merged["KCOR_anchored"]  # backwards-compatible anchored column
+    merged["anchor_status"] = "ok" if valid else ("missing_reference_week" if idx is None else "undefined_reference_ratio")
+    merged["anchor_date"] = merged["DateDied"].iloc[idx] if idx is not None else pd.NaT
+    merged["anchor_ratio"] = ratio
+    return idx, valid
+
