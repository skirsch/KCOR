+        if not isinstance(params,dict):continue
+        g=g.sort_values("t")
+        t=g["t"].to_numpy(float)
+        quiet=np.isin(t,params.get("shape_quiet_weeks",[]))
+        result=_compute_fit_diagnostics(g["CH"].to_numpy(float),t,quiet,
+                                        params.get("k_hat",np.nan),gamma,DYNAMIC_HVE_SKIP_WEEKS)
+        if result is not None:params.update(result)
