+def _update_normalized_shape_diagnostics(df, params_map, sheet_name, gamma):
+    groups=["YearOfBirth","Dose"]
+    if MONTE_CARLO_MODE and "mc_id" in df:groups=["mc_id"]+groups
+    for key,g in df.groupby(groups,sort=False):
+        key=key if isinstance(key,tuple) else (key,)
