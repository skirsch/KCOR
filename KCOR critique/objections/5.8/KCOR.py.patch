+def _compute_fit_diagnostics(H0, t_weeks, quiet_mask, k, gamma, skip):
+    """Within-window residuals of the actual normalized cumulative trajectory.
+
+    Subtract the value at quiet-window entry, so the offset carried into
+    that window is retained rather than imposing one line across gaps.
+    Compare to the integrated Gompertz baseline at week ends.
+    This is descriptive, not an additional fit or acceptance rule.
