+def _sampling_diagnostics(deaths, risk, times, diag):
+    """Plug-in binomial residuals; screening only, not a calibrated fit test."""
+    from scipy.stats import binom
+    if deaths is None or risk is None or "fitted_weekly_hazard" not in diag:return
+    mask=np.asarray(diag["fit_mask_theta"],bool)
+    D=np.asarray(deaths,float);N=np.asarray(risk,float);t=np.asarray(times,float)
+    if D.shape!=mask.shape or N.shape!=mask.shape:return
+    D,N,t=D[mask],N[mask],t[mask]
+    q=np.asarray(diag["fitted_weekly_hazard"],float)
+    if q.shape!=D.shape:return
+    valid=np.isfinite(D)&np.isfinite(N)&np.isfinite(q)&(N>0)&(D>=0)&(D<=N)&(D==np.floor(D))&(N==np.floor(N))&(q>=0)
+    D,N,t,q=D[valid],N[valid],t[valid],q[valid]
+    if not len(D):return
+    p=-np.expm1(-q);mu=N*p;var=mu*(1-p)
+    residual=np.divide(D-mu,np.sqrt(var),out=np.full(len(D),np.nan),where=var>0)
+    prob=np.minimum(1.,2*np.minimum(binom.cdf(D,N,p),binom.sf(D-1,N,p)))
+    cutoff=.05/len(D)
