+    diag.update(sampling_weeks=rows,sampling_flag=bool(np.any(prob<cutoff)),sampling_min_tail=float(prob.min()),sampling_threshold=float(cutoff),sampling_n=len(rows),sampling_pearson_sum=float(np.nansum(residual**2)))
