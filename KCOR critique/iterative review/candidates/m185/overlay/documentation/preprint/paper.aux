\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cox regression produces spurious non-null hazard ratios under a \emph  {synthetic null} as frailty heterogeneity increases. Hazard ratios (with 95\% confidence intervals) from Cox proportional hazards regression comparing cohort B to cohort A in simulations where the true treatment effect is identically zero and cohorts differ only in enrollment-time frailty variance (\(\mittheta _0\)). Deviations from HR=1 arise solely from frailty-driven depletion and associated non-proportional hazards.}}{22}{figure.caption.55}\protected@file@percent }
\newlabel{fig:cox_bias_hr}{{3}{22}{Cox regression produces spurious non-null hazard ratios under a \emph {synthetic null} as frailty heterogeneity increases. Hazard ratios (with 95\% confidence intervals) from Cox proportional hazards regression comparing cohort B to cohort A in simulations where the true treatment effect is identically zero and cohorts differ only in enrollment-time frailty variance (\(\theta _0\)). Deviations from HR=1 arise solely from frailty-driven depletion and associated non-proportional hazards}{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \(\mathrm {KCOR}(t)\) stays near the null benchmark under a synthetic null across increasing frailty heterogeneity. In these simulations, \(\mathrm {KCOR}(t)\) asymptotes remain near 1 across \(\mittheta _0\), which is the diagnostic behavior expected under the working model rather than proof that the model is true or that all confounding has been removed. Error bars show pointwise 95\% person-bootstrap intervals for week-52 KCOR, with the generating frailty variances held fixed. All seven intervals include the null value of 1.}}{23}{figure.caption.56}\protected@file@percent }
\newlabel{fig:cox_bias_kcor}{{4}{23}{\(\mathrm {KCOR}(t)\) stays near the null benchmark under a synthetic null across increasing frailty heterogeneity. In these simulations, \(\mathrm {KCOR}(t)\) asymptotes remain near 1 across \(\theta _0\), which is the diagnostic behavior expected under the working model rather than proof that the model is true or that all confounding has been removed. Error bars show pointwise 95\% person-bootstrap intervals for week-52 KCOR, with the generating frailty variances held fixed. All seven intervals include the null value of 1}{figure.caption.56}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Estimator bias as a function of enrollment-time frailty variance \(\mittheta _0\) on the synthetic-null grid (true hazard ratio 1; true KCOR asymptote 1). \textbf  {Cox:} standard Cox hazard ratio bias, \(\widehat {\mathrm {HR}}-1\). \textbf  {KCOR:} asymptotic \(\mathrm {KCOR}\) bias, \(\widehat {\mathrm {KCOR}}_\infty -1\). \textbf  {Shared-frailty (approx.):} the shared-frailty Cox curve is an \textbf  {approximate reference} constructed from the null-case bias observed in Table \ref {tbl:joint_frailty_comparison} (proportional attenuation of each standard Cox \(\widehat {\mathrm {HR}}\) toward 1 using the ratio of deviations from 1 in that table's gamma-frailty null row), \textbf  {not} a full re-estimation of shared-frailty Cox at each frailty level. Generated by \texttt {test/sim\_grid/code/plot\_estimator\_bias\_vs\_theta.py}.}}{24}{figure.caption.57}\protected@file@percent }
\newlabel{fig:estimator_bias_vs_theta}{{5}{24}{Estimator bias as a function of enrollment-time frailty variance \(\theta _0\) on the synthetic-null grid (true hazard ratio 1; true KCOR asymptote 1). \textbf {Cox:} standard Cox hazard ratio bias, \(\widehat {\mathrm {HR}}-1\). \textbf {KCOR:} asymptotic \(\mathrm {KCOR}\) bias, \(\widehat {\mathrm {KCOR}}_\infty -1\). \textbf {Shared-frailty (approx.):} the shared-frailty Cox curve is an \textbf {approximate reference} constructed from the null-case bias observed in Table \ref {tbl:joint_frailty_comparison} (proportional attenuation of each standard Cox \(\widehat {\mathrm {HR}}\) toward 1 using the ratio of deviations from 1 in that table's gamma-frailty null row), \textbf {not} a full re-estimation of shared-frailty Cox at each frailty level. Generated by \protect \texttt {test/sim\_grid/code/plot\_estimator\_bias\_vs\_theta.py}}{figure.caption.57}{}}
