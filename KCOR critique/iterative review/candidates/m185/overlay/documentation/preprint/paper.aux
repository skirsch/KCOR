\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Empirical negative-control KCOR at December 26, 2022 (pooled/ASMR). Historical v4.3 estimates and analytical intervals are retained for comparison. The current primary analysis uses the all-window fit with the optional nonlinear module inactive; the sensitivity analysis uses the consistent survivor fit at forced alpha=1.18. Both current columns use 999 matched person-bootstrap draws per enrollment. Sources: \texttt {analysis/table8/identified\_only-table8.json} and \texttt {analysis/table8/forced\_alpha-table8.json}; historical source: v4.3 replay of Git commit \texttt {bb2d68249e8bf77c8fb07e6c8336bc790a808a8a} (\texttt {test/negative\_control/out/KCOR\_summary.log} at that commit).}}{50}{table.8}\protected@file@percent }
\newlabel{tbl:neg_control_summary}{{8}{50}{Empirical negative-control KCOR at December 26, 2022 (pooled/ASMR). Historical v4.3 estimates and analytical intervals are retained for comparison. The current primary analysis uses the all-window fit with the optional nonlinear module inactive; the sensitivity analysis uses the consistent survivor fit at forced alpha=1.18. Both current columns use 999 matched person-bootstrap draws per enrollment. Sources: \protect \texttt {analysis/table8/identified\_only-table8.json} and \protect \texttt {analysis/table8/forced\_alpha-table8.json}; historical source: v4.3 replay of Git commit \protect \texttt {bb2d68249e8bf77c8fb07e6c8336bc790a808a8a} (\protect \texttt {test/negative\_control/out/KCOR\_summary.log} at that commit)}{table.8}{}}
