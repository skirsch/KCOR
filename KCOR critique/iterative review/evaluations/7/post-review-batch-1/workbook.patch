+def _complete_week_history(t):
+    """The ordered rows must cover every calendar week from enrollment."""
+    t = np.asarray(t, dtype=float)
+    return bool(len(t) and np.array_equal(t, np.arange(len(t), dtype=float)))
+
+
+def _all_age_source_mask(frame):
+    """Use the same explicit population layout for aggregate fit and inversion."""
+    supplied = frame["YearOfBirth"] == -2
+    if supplied.any():
+        return supplied
+    if os.environ.get("KCOR_BOOTSTRAP_LAYOUT", "disjoint") == "table8":
+        # The 1960 pseudo-birth-year is inclusive of the 1940 and 1950 groups.
+        return frame["YearOfBirth"] == 1960
+    return (frame["YearOfBirth"] > 0) | (frame["YearOfBirth"] == -1)
+
+
+def _flag_unavailable_normalization(rows, frame, sheet):
+    """Do not report a different contrast by dropping a failed contributor."""
+    if rows.empty or "normalization_status" not in frame:
+        return rows
+    rows = rows.copy()
+    rows["normalization_status"] = "ok"
+    bad = frame[~frame["normalization_status"].eq("ok")]
+    if bad.empty:
+        return rows
+    rows["abnormal_fit"] = rows["abnormal_fit"].astype(object)
+    group_cols = ["YearOfBirth", "Dose"]
+    mc = "mc_id" in frame.columns and "mc_id" in rows.columns
+    if mc:
+        group_cols = ["mc_id"] + group_cols
+    for key, g in bad.groupby(group_cols, sort=False):
+        draw, yob, dose = key if mc else (None, *key)
+        group = frame[frame["YearOfBirth"] == yob]
+        if mc:
+            group = group[group.mc_id == draw]
+        status_by_date = g.set_index("DateDied")["normalization_status"]
+        for status, dates in status_by_date.groupby(status_by_date):
+            affected = (rows["Dose_num"] == dose) | (rows["Dose_den"] == dose)
+            if status not in ("missing_week_history", "normalization_failed") and not (
+                    g.loc[g.normalization_status.eq(status), "t"] <= KCOR_NORMALIZATION_WEEKS_EFFECTIVE).any():
+                affected &= pd.to_datetime(rows["Date"]).isin(dates.index)
+            if mc:
+                affected &= rows.mc_id == draw
+            direct = rows["YearOfBirth"] == yob
+            # A pooled comparison requires both source dose groups and positive
+            # weight. Do not renormalize over the remaining groups on failure.
+            weights = ASMR_WEIGHTS_BY_SHEET.get(sheet, {})
+            paired = rows["Dose_num"].isin(group.Dose) & rows["Dose_den"].isin(group.Dose)
+            pooled = (rows["YearOfBirth"] == 0) & paired & (yob > 0) & (weights.get(yob, 0.) > 0)
+            affected &= direct | pooled
+            rows.loc[affected, "normalization_status"] = status
+            rows.loc[affected, "abnormal_fit"] = True
+            cols = [c for c in ("KCOR","KCOR_unanchored","KCOR_anchored","CI_lower","CI_upper") if c in rows]
+            rows.loc[affected, cols] = np.nan
+    return rows
+
 
