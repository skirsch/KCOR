+def _prepare_mc_population(frame, enrollment_date, layout, total_scope, dual_print, sheet):
+    """Validate and select direct aggregate populations before MC display filtering.
+
+    Each replicate has its own source calendar and source coverage. The
+    ordinary source-history and inclusive-total reconciliation rules apply
+    to the original rows, not the display subset. Return one supplied or
+    reconstructed all-ages history per dose, never both.
+    """
+    from fixed_cohort_history import invalid_components, aggregate_reconciliation
+    source_bad, aggregate_bad, available, coverage = {}, {}, {}, {}
+    prepared = []
+    has_id = "mc_id" in frame.columns
+    groups = frame.groupby("mc_id", sort=False) if has_id else [(None, frame)]
+    for draw, raw in groups:
+        raw = raw.copy()
+        totals = raw.YearOfBirth.isin(SPECIAL_AGGREGATE_YOBS)
+        # MC aggregate rows may omit optional stratum metadata; their
+        # inclusive label already identifies those fields as aggregate.
+        for col, inclusive in [("Sex", "O"), ("DCCI", -1)]:
+            if col in raw:
+                raw.loc[totals & raw[col].isna(), col] = inclusive
+        bad = invalid_components(raw, enrollment_date, raw.DateDied.max(), layout)
+        bad_totals = {}
+        if layout == "disjoint":
+            bad_totals, _ = aggregate_reconciliation(raw, total_scope)
+            if total_scope == "exhaustive":
+                for (age, dose), reasons in list(bad.items()):
+                    if age in SPECIAL_AGGREGATE_YOBS:
+                        continue
+                    for total_age in (-2, -60):
+                        if (total_age == -60 and age < 1960) or not ((raw.YearOfBirth == total_age) & (raw.Dose == dose)).any():
+                            continue
+                        bad_totals.setdefault((total_age, dose), []).extend(reasons)
+            for key, reasons in bad_totals.items():
+                bad.setdefault(key, []).extend(reasons)
+        supplied = raw.YearOfBirth.eq(-2)
+        components = raw[(raw.YearOfBirth > 0) | raw.YearOfBirth.eq(-1)]
+        available[draw] = layout == "disjoint" and total_scope == "partial" and not supplied.any()
+        coverage[draw] = {}
+        if available[draw]:
+            for dose, part in components.groupby("Dose"):
+                ages = sorted(int(a) for a in part.YearOfBirth.unique())
+                opening = part[part.DateDied.eq(pd.Timestamp(enrollment_date))].groupby("YearOfBirth").Alive.sum()
+                zeros = sorted(int(a) for a, n in opening.items() if n == 0)
+                coverage[draw][dose] = (",".join(map(str, ages)) or "none", ",".join(map(str, zeros)) or "none")
+        if MC_INCLUDE_AGGREGATES:
+            if supplied.any():
+                missing = components[~components.Dose.isin(raw.loc[supplied, "Dose"])] if layout == "disjoint" and total_scope == "exhaustive" else components.iloc[:0]
+            else:
+                missing = raw[raw.YearOfBirth.eq(1960)] if layout == "table8" else components
+            if not missing.empty:
+                aggregate = missing.groupby(["Dose", "DateDied"], as_index=False).agg(
+                    ISOweekDied=("ISOweekDied", "first"), Alive=("Alive", "sum"), Dead=("Dead", "sum"))
+                aggregate["YearOfBirth"] = -2
+                if has_id:
+                    aggregate["mc_id"] = draw
+                for (age, dose), reasons in list(bad.items()):
+                    if ((missing.YearOfBirth == age) & (missing.Dose == dose)).any():
+                        bad.setdefault((-2, dose), []).extend(reasons)
+                raw = pd.concat([raw, aggregate], ignore_index=True)
+        prefix = (draw,) if has_id else ()
+        for key, reasons in bad.items():
+            source_bad[prefix + key] = reasons
+            dual_print(f"[WARN] KCOR_SOURCE_HISTORY,EnrollmentDate={sheet},mc_id={draw},yob={key[0]},dose={key[1]},reason={reasons}")
+        for key, reasons in bad_totals.items():
+            aggregate_bad[prefix + key] = reasons
+        prepared.append(raw)
+    return (pd.concat(prepared, ignore_index=True) if prepared else frame, source_bad, aggregate_bad, available, coverage)
+
