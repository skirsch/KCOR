+def post_wave_baseline_increases(observed_increases, theta, alpha, baseline_end, wave_end):
+    """Invert conditional survival from wave exit, with the exit exposures fixed.
+
+    Inputs and outputs are cumulative increases since the end of the wave.
+    Baseline selection tilts the starting gamma law by a scale factor
+    1/(1+theta*B). Integrate the remaining wave term against that gamma law.
+    """
+    observed = np.asarray(observed_increases, dtype=float)
+    if theta < KCOR6_THETA_EPS:
+        return observed.copy()
+    exit_scale = 1.0 + theta * baseline_end
+    if wave_end == 0.0 or alpha == 1.0:
+        return (exit_scale + theta * wave_end) * np.expm1(theta * observed) / theta
+
+    # Integrate over gamma probabilities with extra resolution in both tails.
+    # Symmetric subintervals keep the upper quantiles away from rounded p=1.
+    nodes, weights = roots_legendre(32)
+    edges = np.array([0.0, 1e-10, 1e-8, 1e-6, 1e-5, 1e-4, 0.001, 0.01, 0.1, 0.5])
+    half_width = np.diff(edges)[:, None] / 2.0
+    probs = (edges[:-1, None] + half_width * (nodes + 1.0)).ravel()
+    half_weights = (half_width * weights).ravel()
+    probs = np.concatenate((probs, 1.0 - probs))
+    weights = np.tile(half_weights, 2)
+    z = theta * gammaincinv(1.0 / theta, probs)
+
+    def wave_log_survival(baseline):
+        scaled = z / (1.0 + theta * baseline)
+        powers = wave_end * np.power(scaled, alpha)
+        lost = np.dot(weights, -np.expm1(-powers))
+        if lost < 0.5:
+            return np.log1p(-lost)
+        return logsumexp(-powers, b=weights)
+
+    log_wave_exit = wave_log_survival(baseline_end)
+
+    def observed_gain(increase):
+        gamma_gain = np.log1p(theta * increase / exit_scale) / theta
+        return gamma_gain + log_wave_exit - wave_log_survival(baseline_end + increase)
+
+    result = np.zeros_like(observed)
+    previous = 0.0
+    for i, target in enumerate(observed):
+        if target > 0 and (i == 0 or target != observed[i - 1]):
+            upper = max(previous * 2, exit_scale * target, 1e-10)
+            while observed_gain(upper) < target:
+                upper *= 2
+                if not np.isfinite(upper):
+                    raise ArithmeticError("Could not bracket the post-wave baseline increase")
+            previous = brentq(lambda x: observed_gain(x) - target, 0.0, upper, xtol=1e-14)
+        result[i] = previous
+    return result
+
