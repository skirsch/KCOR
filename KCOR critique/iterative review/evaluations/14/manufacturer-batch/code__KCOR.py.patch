+def _manufacturer_results(src_path, sheets, log):
+    """Use the ordinary fixed-cohort estimator for the auxiliary M/P sheets."""
+    from manufacturer_history import TARGETS, reconcile
+    from bootstrap_reporting import attach
+    from types import SimpleNamespace
+    from tempfile import TemporaryDirectory
+    from pathlib import Path
+    from contextlib import redirect_stdout, redirect_stderr
+    import io
+    results = {}
+    if os.environ.get("KCOR_BOOTSTRAP_LAYOUT", "disjoint") != "disjoint" or not any(sh in TARGETS for sh in sheets):
+        return results
+    with pd.ExcelFile(src_path) as source:
+        for sheet in sheets:
+            dose = TARGETS.get(sheet)
+            source_sheet = f"{sheet}_MFG_D{dose}"
+            if dose is None or source_sheet not in source.sheet_names:
+                continue
+            name = f"MFG_MP_{sheet}_D{dose}_decades"
+            try:
+                history = pd.read_excel(source, sheet_name=source_sheet)
+                ordinary = pd.read_excel(source, sheet_name=sheet)
+                start = _parse_enrollment_date(sheet)
+                reconcile(history, ordinary, start, dose)
+                history["DateDied"] = pd.to_datetime(history.DateDied)
+                history = history.loc[history.DateDied.ge(start) & history.MFG.isin(["M","P"])].copy()
+                if set(history.MFG) != {"M","P"}:
+                    raise ValueError("Both manufacturers are required")
+                # Internal group IDs only; both groups received the same actual dose.
+                history["Dose"] = history.MFG.map({"P":0,"M":1})
+                history = history.drop(columns="MFG")
+                settings = globals()
+                names = ("ENROLLMENT_DATES","OVERRIDE_DOSE_PAIRS","OVERRIDE_YOBS","AGE_RANGE",
+                         "SLOPE_DEBUG_FILE","KCOR_NORMALIZATION_WEEKS","KCOR_NORMALIZATION_WEEKS_EFFECTIVE")
+                previous = {k:settings[k] for k in names}
+                weights = ASMR_WEIGHTS_BY_SHEET.copy()
+                try:
+                    settings.update(ENROLLMENT_DATES=[sheet], OVERRIDE_DOSE_PAIRS=[(1,0)], OVERRIDE_YOBS=None, AGE_RANGE=10)
+                    with TemporaryDirectory(prefix="kcor-mfg-",ignore_cleanup_errors=True) as tmp:
+                        path = Path(tmp)/"source.xlsx"
+                        history.to_excel(path,sheet_name=sheet,index=False)
+                        with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+                            rows = process_workbook(str(path),str(Path(tmp)/"output.xlsx"),return_rows=True)
+                        rows = attach(SimpleNamespace(**settings),rows,str(path),[sheet],log)
+                    rows = rows.loc[rows.YearOfBirth.gt(0) & rows.Dose_num.eq(1) & rows.Dose_den.eq(0)].copy()
+                    rows["Dose_num"] = rows["Dose_den"] = dose
+                    rows["MFG_num"], rows["MFG_den"] = "M","P"
+                    rows["KCOR_MP"] = rows.KCOR
+                    rows["manufacturer_status"] = np.where(np.isfinite(rows.KCOR),"ok","unavailable")
+                    results[name] = rows
+                finally:
+                    settings.update(previous)
+                    ASMR_WEIGHTS_BY_SHEET.clear()
+                    ASMR_WEIGHTS_BY_SHEET.update(weights)
+            except (ValueError,KeyError,ArithmeticError,OSError,TypeError) as e:
+                log(f"[MFG] {sheet}: unavailable: {e}")
+                results[name] = pd.DataFrame([dict(EnrollmentDate=sheet,Dose_num=dose,Dose_den=dose,
+                    MFG_num="M",MFG_den="P",KCOR_MP=np.nan,CI_lower=np.nan,CI_upper=np.nan,
+                    manufacturer_status="unavailable",reason=str(e))])
+    return results
+
 
